# Base de datos PostgreSQL
DATABASE_URL="postgresql://joaquin:joaquin@localhost:5432/joaquin"
# Opcional: esquema aislado (el rol de la base debe tener search_path = este esquema)
# DB_SCHEMA="joaquin"
# Opcional: TLS para bases en la nube (Supabase lo activa solo)
# DATABASE_SSL="true"

# Secreto largo y aleatorio (firma de enlaces temporales). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Carpeta PRIVADA donde se guardan fotos y videos (nunca dentro de /public)
STORAGE_DIR="./storage"

# Primer administrador (lo crea `npm run db:seed`)
ADMIN_NAME="Hernán"
ADMIN_EMAIL="admin@joaquin.familia"
ADMIN_PASSWORD="cambia-esta-clave"

# En producción con HTTPS déjalo en true. Para probar en red local por http pon false.
COOKIE_SECURE="true"

# Tamaños máximos de subida (MB)
MAX_IMAGE_MB="30"
MAX_VIDEO_MB="600"

# ——— Sólo en Vercel ———
# BLOB_READ_WRITE_TOKEN lo crea Vercel al conectar un Blob store PRIVADO al proyecto.
# Con él, las fotos y videos se guardan en Vercel Blob en lugar del disco.
# NEXT_PUBLIC_STORAGE="blob"
